---
import { Image, getImage } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Loop from './Loop.astro';
import VideoEmbed from './VideoEmbed.astro';
import { paragraphs } from '../lib/text';

interface Props { entry: CollectionEntry<'work'> }
const { entry } = Astro.props;
const d = entry.data;
type Block = (typeof d.blocks)[number];
type Credits = { agency?: string; client?: string; role?: string };

/*
 * Group the flat block list the way the original site laid pages out:
 *  - intro: big heading + Agency/Client on the left, copy on the right
 *  - label: small heading above media (Case Study, OOH, ...)
 *  - media: images / videos, edge to edge
 */
type Intro = { kind: 'intro'; heading?: string; credits?: Credits; texts: string[] };
type Item =
  | Intro
  | { kind: 'label'; text: string }
  | { kind: 'images'; block: Extract<Block, { images: unknown }>; full?: string[] }
  | { kind: 'videos'; block: Extract<Block, { videos: unknown }> };

const items: Item[] = [];
let cur: Intro | undefined;
for (const b of d.blocks) {
  if ('heading' in b) {
    if (b.level >= 4) { items.push({ kind: 'label', text: b.heading }); cur = undefined; }
    else { cur = { kind: 'intro', heading: b.heading, texts: [] }; items.push(cur); }
  } else if ('credits' in b) {
    if (!cur || cur.texts.length) { cur = { kind: 'intro', texts: [] }; items.push(cur); }
    cur.credits = b.credits;
  } else if ('text' in b) {
    if (!cur) { cur = { kind: 'intro', texts: [] }; items.push(cur); }
    cur.texts.push(b.text);
  } else if ('images' in b) { items.push({ kind: 'images', block: b }); cur = undefined; }
  else if ('videos' in b) { items.push({ kind: 'videos', block: b }); cur = undefined; }
}
// The first intro is the page hero: it carries the title and the page-level credits.
let hero = items[0]?.kind === 'intro' ? (items[0] as Intro) : undefined;
if (!hero) { hero = { kind: 'intro', texts: [] }; items.unshift(hero); }
hero.heading ??= d.title;
hero.credits ??= { agency: d.agency, client: d.client, role: d.role };

const creditRows = (c?: Credits) =>
  c ? ([['Role', c.role], ['Agency', c.agency], ['Client', c.client]].filter(([, v]) => v) as [string, string][]) : [];

// Blocks with `zoom: true` get a large copy of each image for the lightbox.
for (const it of items) {
  if (it.kind === 'images' && it.block.zoom) {
    it.full = await Promise.all(
      it.block.images.map(async (i) => (await getImage({ src: i.src, width: Math.min(i.src.width, 2000), format: 'webp' })).src),
    );
  }
}
const hasZoom = items.some((it) => it.kind === 'images' && it.full);

let section = d.title;
---
<div class="blocks">
  {items.map((it, idx) => {
    if (it.kind === 'intro') {
      section = it.heading ?? section;
      const Tag = idx === 0 ? 'h1' : 'h2';
      return (
        <section class:list={['intro', { hero: idx === 0 }]}>
          <div class="left">
            {it.heading && <Tag class="title">{it.heading}</Tag>}
            {creditRows(it.credits).length > 0 && (
              <dl class="credits">
                {creditRows(it.credits).map(([k, v]) => <div><dt>{k}:</dt><dd>{v}</dd></div>)}
              </dl>
            )}
          </div>
          <div class="right">
            {it.texts.map((t) => paragraphs(t).map((p) => <p set:html={p} />))}
          </div>
        </section>
      );
    }
    if (it.kind === 'label') {
      section = it.text;
      return <h3 class="media-label">{it.text}</h3>;
    }
    if (it.kind === 'images') {
      const imgs = it.block.images;
      const n = imgs.length;
      const portrait = imgs.filter((i) => i.src.height > i.src.width * 1.1).length > n / 2;
      // Horizontal images run full page width; vertical ones pair up.
      // Small horizontals (< 1200px, e.g. the DoorDash loops) stay two-up so they don't go blurry.
      // `wide: true/false` on an image in the YAML overrides this.
      const cols = n === 1 ? 1 : portrait && n >= 6 && n % 4 === 0 ? 4 : 2;
      const autoWide = (i: (typeof imgs)[number]) => i.src.width > i.src.height * 1.1 && i.src.width >= 1200;
      const isWide = imgs.map((img) => cols > 1 && (img.wide ?? autoWide(img)));
      // A run of exactly three side-by-side images sits on one line (thirds) instead of 2 + 1.
      const third = imgs.map(() => false);
      // A lone tall image (e.g. one poster) sits in the middle third, as if it were a set of 3.
      const solo = n === 1 && portrait && imgs[0].wide !== true;   // `wide: true` keeps it full width
      for (let i = 0; i < n; ) {
        if (isWide[i]) { i++; continue; }
        let j = i; while (j < n && !isWide[j]) j++;
        if (j - i === 3 && cols === 2) for (let k = i; k < j; k++) third[k] = true;
        i = j;
      }
      return (
        <div class="media" style={`--cols:${cols}`}>
          {imgs.map((img, i) => {
            const wide = isWide[i];
            const sizes = solo ? '(min-width: 768px) 33vw, 100vw' : cols === 1 || wide ? '100vw' : `(min-width: 768px) ${third[i] ? 33 : Math.round(100 / cols)}vw, 100vw`;
            const cls = ['m', { wide, third: third[i], solo }];
            const alt = img.alt ?? `${section}, image ${i + 1}`;
            const widths = cols === 1 || wide ? [640, 1024, 1600, 2400] : [400, 720, 1100, 1500];
            if (img.loop) return <Loop src={img.loop} poster={img.src} label={img.alt ?? `${section}, animation ${i + 1}`} class:list={cls} />;
            if (it.full) return (
              <a href={it.full[i]} class:list={['zoom', { wide, third: third[i], solo }]} data-zoom aria-label={`Enlarge: ${alt}`}>
                <Image src={img.src} alt={alt} widths={widths} sizes={sizes} class="m" />
              </a>
            );
            return <Image src={img.src} alt={alt} widths={widths} sizes={sizes} class:list={cls} />;
          })}
        </div>
      );
    }
    if (it.kind === 'videos') {
      const v = it.block.videos;
      return (
        <div class="media" style={`--cols:${v.length >= 3 ? 3 : v.length}`}>
          {v.map((x) => <VideoEmbed {...x} project={entry.id} fallbackTitle={`${section} video`} />)}
        </div>
      );
    }
  })}
</div>

{hasZoom && (
  <dialog class="lightbox" aria-label="Enlarged image">
    <img alt="" />
    <button type="button" class="lb-btn lb-close" aria-label="Close">&times;</button>
    <button type="button" class="lb-btn lb-prev" aria-label="Previous image">&lsaquo;</button>
    <button type="button" class="lb-btn lb-next" aria-label="Next image">&rsaquo;</button>
  </dialog>
)}

<script>
  const dlg = document.querySelector<HTMLDialogElement>('dialog.lightbox');
  if (dlg) {
    const img = dlg.querySelector('img')!;
    let group: HTMLAnchorElement[] = [];
    let idx = 0;
    const show = (i: number) => {
      idx = (i + group.length) % group.length;
      const a = group[idx];
      img.src = a.href;
      img.alt = a.querySelector('img')?.alt ?? '';
    };
    document.addEventListener('click', (e) => {
      const a = (e.target as Element).closest<HTMLAnchorElement>('a[data-zoom]');
      if (!a || e.metaKey || e.ctrlKey || e.shiftKey) return;   // let modified clicks open a tab
      e.preventDefault();
      group = [...(a.parentElement?.querySelectorAll<HTMLAnchorElement>('a[data-zoom]') ?? [a])];
      dlg.classList.toggle('single', group.length < 2);
      show(group.indexOf(a));
      dlg.showModal();
    });
    dlg.querySelector('.lb-prev')!.addEventListener('click', () => show(idx - 1));
    dlg.querySelector('.lb-next')!.addEventListener('click', () => show(idx + 1));
    dlg.querySelector('.lb-close')!.addEventListener('click', () => dlg.close());
    // Clicking the backdrop or the image closes it.
    dlg.addEventListener('click', (e) => { if (e.target === dlg || e.target === img) dlg.close(); });
    dlg.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(idx - 1);
      if (e.key === 'ArrowRight') show(idx + 1);
    });
    dlg.addEventListener('close', () => img.removeAttribute('src'));
  }
</script>

<style>
  .blocks { display: grid; gap: var(--gap); }

  .intro {
    display: grid; gap: 28px 3rem; grid-template-columns: 1fr;
    padding-top: 72px; padding-bottom: 30px;
  }
  .intro.hero { padding-top: clamp(96px, 22vw, 320px); }
  .title { font-size: var(--fs-title); line-height: 0.83; max-width: 14em; }
  .credits { margin: 1.9rem 0 0; display: grid; gap: 1.1rem; }
  .credits dt { color: var(--muted); }
  .credits dd { margin: 0; }
  .right { max-width: 37rem; }
  .right:empty { display: none; }

  .media-label {
    font-size: var(--fs-lead); line-height: 1; padding-top: 50px; padding-bottom: 6px;
  }

  .media {
    display: grid; gap: var(--gap); align-items: start;
    grid-template-columns: 1fr;
  }
  .media :global(.m) { width: 100%; height: auto; border-radius: 3px; background: var(--surface); }
  .zoom { display: block; cursor: zoom-in; }
  .zoom:focus-visible { outline: 2px solid var(--ink); outline-offset: 3px; }

  .lightbox {
    padding: 0; border: 0; background: transparent;
    width: 100vw; height: 100dvh; max-width: none; max-height: none;
  }
  .lightbox[open] { display: grid; place-items: center; animation: lb-in 180ms ease-out; }
  .lightbox::backdrop { background: rgba(0, 0, 0, 0.9); }
  .lightbox img {
    max-width: calc(100vw - 2 * var(--pad) - 96px); max-height: calc(100dvh - 2 * var(--pad));
    width: auto; height: auto; object-fit: contain; border-radius: 3px; cursor: zoom-out;
  }
  .lb-btn {
    position: fixed; width: 44px; height: 44px; border: 0; border-radius: 50%;
    background: rgba(255, 255, 255, 0.12); color: #fff; font-size: 28px; line-height: 1; cursor: pointer;
  }
  .lb-btn:hover, .lb-btn:focus-visible { background: rgba(255, 255, 255, 0.25); }
  .lb-close { top: var(--pad); right: var(--pad); }
  .lb-prev, .lb-next { top: 50%; translate: 0 -50%; }
  .lb-prev { left: var(--pad); }
  .lb-next { right: var(--pad); }
  .lightbox.single .lb-prev, .lightbox.single .lb-next { display: none; }
  @media (max-width: 767px) {
    .lightbox img { max-width: 100vw; max-height: calc(100dvh - 140px); border-radius: 0; }
    .lb-prev, .lb-next { top: auto; bottom: var(--pad); translate: none; }
  }
  @keyframes lb-in { from { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .lightbox[open] { animation: none; } }
  :global(html:has(dialog.lightbox[open])) { overflow: hidden; }

  @media (min-width: 768px) {
    .intro { grid-template-columns: minmax(0, 1.65fr) minmax(0, 1fr); }
    /* 12-track grid so halves, quarters and thirds can share a block */
    .media { grid-template-columns: repeat(12, minmax(0, 1fr)); }
    .media > :global(*) { grid-column: span calc(12 / var(--cols)); }
    .media > :global(.third) { grid-column: span 4; }
    .media > :global(.solo) { grid-column: 5 / span 4; }
    .media > :global(.wide) { grid-column: 1 / -1; }
  }
</style>
