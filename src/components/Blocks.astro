---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Loop from './Loop.astro';
import VideoEmbed from './VideoEmbed.astro';
import { paragraphs } from '../lib/text';

interface Props { entry: CollectionEntry<'work'> }
const { entry } = Astro.props;
const d = entry.data;
type Block = (typeof d.blocks)[number];
type Credits = { agency?: string; client?: string; role?: string };

/*
 * Group the flat block list the way the original site laid pages out:
 *  - intro: big heading + Agency/Client on the left, copy on the right
 *  - label: small heading above media (Case Study, OOH, ...)
 *  - media: images / videos, edge to edge
 */
type Intro = { kind: 'intro'; heading?: string; credits?: Credits; texts: string[] };
type Item =
  | Intro
  | { kind: 'label'; text: string }
  | { kind: 'images'; block: Extract<Block, { images: unknown }> }
  | { kind: 'videos'; block: Extract<Block, { videos: unknown }> };

const items: Item[] = [];
let cur: Intro | undefined;
for (const b of d.blocks) {
  if ('heading' in b) {
    if (b.level >= 4) { items.push({ kind: 'label', text: b.heading }); cur = undefined; }
    else { cur = { kind: 'intro', heading: b.heading, texts: [] }; items.push(cur); }
  } else if ('credits' in b) {
    if (!cur || cur.texts.length) { cur = { kind: 'intro', texts: [] }; items.push(cur); }
    cur.credits = b.credits;
  } else if ('text' in b) {
    if (!cur) { cur = { kind: 'intro', texts: [] }; items.push(cur); }
    cur.texts.push(b.text);
  } else if ('images' in b) { items.push({ kind: 'images', block: b }); cur = undefined; }
  else if ('videos' in b) { items.push({ kind: 'videos', block: b }); cur = undefined; }
}
// The first intro is the page hero: it carries the title and the page-level credits.
let hero = items[0]?.kind === 'intro' ? (items[0] as Intro) : undefined;
if (!hero) { hero = { kind: 'intro', texts: [] }; items.unshift(hero); }
hero.heading ??= d.title;
hero.credits ??= { agency: d.agency, client: d.client, role: d.role };

const creditRows = (c?: Credits) =>
  c ? ([['Role', c.role], ['Agency', c.agency], ['Client', c.client]].filter(([, v]) => v) as [string, string][]) : [];

let section = d.title;
---
<div class="blocks">
  {items.map((it, idx) => {
    if (it.kind === 'intro') {
      section = it.heading ?? section;
      const Tag = idx === 0 ? 'h1' : 'h2';
      return (
        <section class:list={['intro', { hero: idx === 0 }]}>
          <div class="left">
            {it.heading && <Tag class="title">{it.heading}</Tag>}
            {creditRows(it.credits).length > 0 && (
              <dl class="credits">
                {creditRows(it.credits).map(([k, v]) => <div><dt>{k}:</dt><dd>{v}</dd></div>)}
              </dl>
            )}
          </div>
          <div class="right">
            {it.texts.map((t) => paragraphs(t).map((p) => <p set:html={p} />))}
          </div>
        </section>
      );
    }
    if (it.kind === 'label') {
      section = it.text;
      return <h3 class="media-label">{it.text}</h3>;
    }
    if (it.kind === 'images') {
      const imgs = it.block.images;
      const n = imgs.length;
      const portrait = imgs.filter((i) => i.src.height > i.src.width * 1.1).length > n / 2;
      // Like the original: one image runs full width; groups go two-up, odd one out spans the top.
      const cols = n === 1 ? 1 : portrait && n >= 6 && n % 4 === 0 ? 4 : 2;
      return (
        <div class="media" style={`--cols:${cols}`}>
          {imgs.map((img, i) => {
            const wide = cols > 1 && n % cols === 1 && i === 0;
            const sizes = cols === 1 || wide ? '100vw' : `(min-width: 768px) ${Math.round(100 / cols)}vw, 100vw`;
            return img.loop ? (
              <Loop src={img.loop} poster={img.src} label={img.alt ?? `${section}, animation ${i + 1}`} class:list={['m', { wide }]} />
            ) : (
              <Image
                src={img.src}
                alt={img.alt ?? `${section}, image ${i + 1}`}
                widths={cols === 1 || wide ? [640, 1024, 1600, 2400] : [400, 720, 1100, 1500]}
                sizes={sizes}
                class:list={['m', { wide }]}
              />
            );
          })}
        </div>
      );
    }
    if (it.kind === 'videos') {
      const v = it.block.videos;
      return (
        <div class="media" style={`--cols:${v.length >= 3 ? 3 : v.length}`}>
          {v.map((x) => <VideoEmbed {...x} fallbackTitle={`${section} video`} />)}
        </div>
      );
    }
  })}
</div>

<style>
  .blocks { display: grid; gap: var(--gap); }

  .intro {
    display: grid; gap: 28px 3rem; grid-template-columns: 1fr;
    padding-top: 72px; padding-bottom: 30px;
  }
  .intro.hero { padding-top: clamp(96px, 22vw, 320px); }
  .title { font-size: var(--fs-title); line-height: 0.83; max-width: 14em; }
  .credits { margin: 1.9rem 0 0; display: grid; gap: 1.1rem; }
  .credits dt { color: var(--muted); }
  .credits dd { margin: 0; }
  .right { max-width: 37rem; }
  .right:empty { display: none; }

  .media-label {
    font-size: var(--fs-lead); line-height: 1; padding-top: 50px; padding-bottom: 6px;
  }

  .media {
    display: grid; gap: var(--gap); align-items: start;
    grid-template-columns: 1fr;
  }
  .media :global(.m) { width: 100%; height: auto; border-radius: 3px; background: var(--surface); }
  @media (min-width: 768px) {
    .intro { grid-template-columns: minmax(0, 1.65fr) minmax(0, 1fr); }
    .media { grid-template-columns: repeat(var(--cols), minmax(0, 1fr)); }
    .media :global(.wide) { grid-column: 1 / -1; }
  }
</style>
