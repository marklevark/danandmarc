---
interface Props {
  provider: 'file' | 'vimeo' | 'youtube';
  id: string;
  project: string;
  src?: string;
  poster?: string;
  title?: string;
  fallbackTitle: string;
}
const { provider, id, project, src, poster, title, fallbackTitle } = Astro.props;
// Squarespace kept export filenames as titles ("..._v14mp4"); don't show those to screen readers.
const label = title && !/[_]|mp4$/i.test(title) ? title : fallbackTitle;
// Poster: /media/<project>/<id>.jpg (scripts/make-posters.sh makes any that are missing).
// If it's missing anyway, preload=metadata + #t=1 makes the browser show the frame at 1s instead of black.
const embed =
  provider === 'vimeo'
    ? `https://player.vimeo.com/video/${id}?dnt=1&title=0&byline=0&portrait=0`
    : `https://www.youtube-nocookie.com/embed/${id}?rel=0`;
---
<div class="embed">
  {provider === 'file' ? (
    <video
      src={`${src ?? `/media/${project}/${id}.mp4`}#t=1`}
      poster={poster ?? `/media/${project}/${id}.jpg`}
      controls
      playsinline
      preload="metadata"
      data-rewind
      aria-label={label}
    ></video>
  ) : (
    <iframe src={embed} title={label} loading="lazy" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen></iframe>
  )}
</div>
<script>
  // #t=1 is only there so a frame shows before play; start playback from the top.
  document.querySelectorAll<HTMLVideoElement>('video[data-rewind]').forEach((v) => {
    v.addEventListener('play', () => { if (v.currentTime <= 1.05) v.currentTime = 0; }, { once: true });
  });
</script>
<style>
  .embed { position: relative; aspect-ratio: 16 / 9; background: #000; overflow: hidden; }
  iframe, video { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  video { object-fit: contain; }
</style>
