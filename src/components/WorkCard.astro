---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Loop from './Loop.astro';

interface Props { entry: CollectionEntry<'work'>; eager?: boolean }
const { entry, eager = false } = Astro.props;
const d = entry.data;
---
<a class="card" href={`/work/${entry.id}`} style={`--pos:${d.coverPosition}`}>
  {d.coverLoop ? (
    <Loop src={d.coverLoop} poster={d.cover} class="fill" />
  ) : (
    <Image
      src={d.cover}
      alt=""
      widths={[400, 640, 900, 1200]}
      sizes="(min-width: 768px) 33vw, 100vw"
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : 'auto'}
      class="fill"
    />
  )}
  <span class="overlay"><h3>{d.title}</h3></span>
</a>

<style>
  .card {
    position: relative; display: block; aspect-ratio: 1; overflow: hidden;
    border-radius: 3px; background: var(--surface);
  }
  .card:hover { opacity: 1; }
  .card :global(.fill) { width: 100%; height: 100%; object-fit: cover; object-position: var(--pos); }
  .overlay {
    position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;
    padding: 1.5rem; text-align: center; color: #fafafa;
    background: rgba(0, 0, 0, 0.55); opacity: 0; transition: opacity 0.25s ease;
  }
  h3 { font-size: var(--fs-card); line-height: 0.9; }
  .card:hover .overlay, .card:focus-visible .overlay { opacity: 1; }
  /* touch screens can't hover: keep titles readable at the bottom */
  @media (hover: none) {
    .overlay {
      opacity: 1; align-items: flex-end; justify-content: flex-start; text-align: left;
      background: linear-gradient(to top, rgba(0, 0, 0, 0.6), transparent 45%);
      padding: 1rem;
    }
  }
</style>
