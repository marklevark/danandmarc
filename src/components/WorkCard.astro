---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Loop from './Loop.astro';

interface Props { entry: CollectionEntry<'work'>; index: number; eager?: boolean }
const { entry, index, eager = false } = Astro.props;
const d = entry.data;
const sub = [d.client, d.agency && d.agency !== d.client ? d.agency : undefined].filter(Boolean).join(' / ');
---
<a class="card" href={`/work/${entry.id}`}>
  <div class="media">
    {d.coverLoop ? (
      <Loop src={d.coverLoop} poster={d.cover} class="fill" />
    ) : (
      <Image
        src={d.cover}
        alt=""
        widths={[480, 800, 1200, 1600]}
        sizes="(min-width: 860px) 50vw, 100vw"
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={eager ? 'high' : 'auto'}
        class="fill"
      />
    )}
  </div>
  <div class="meta">
    <span class="num">{String(index + 1).padStart(2, '0')}</span>
    <h3>{d.title}</h3>
    {sub && <p>{sub}</p>}
  </div>
</a>

<style>
  .card { display: block; text-decoration: none; color: var(--ink); }
  .card:hover { color: var(--ink); }
  .media {
    aspect-ratio: 4 / 3; overflow: hidden; border-radius: var(--radius); background: var(--surface);
  }
  .media :global(.fill) {
    width: 100%; height: 100%; object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .card:hover .media :global(.fill) { transform: scale(1.035); }
  .meta {
    display: grid; grid-template-columns: auto 1fr; column-gap: 0.9rem; align-items: baseline;
    padding-top: 0.9rem;
  }
  .num { font-size: var(--step--1); font-weight: 600; color: var(--muted); font-variant-numeric: tabular-nums; }
  h3 { font-size: var(--step-2); letter-spacing: -0.03em; line-height: 1.05; }
  .card:hover h3 { color: var(--accent); }
  p { grid-column: 2; margin: 0.3rem 0 0; color: var(--muted); font-size: var(--step--1); font-weight: 500; }
</style>
