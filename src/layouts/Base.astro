---
import '../styles/global.css';
import Wordmark from '../components/Wordmark.astro';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}
const { title, description = site.description, image } = Astro.props;
const fullTitle = title ? `${title} — ${site.name}` : site.name;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = image ? new URL(image, Astro.site).href : undefined;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) =>
  href === '/' ? path === '/' || path.startsWith('/work') : path.startsWith(href);
---
<!doctype html>
<html lang="en-CA">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {site.adobeFontsKit && (
      <>
        <link rel="preconnect" href="https://use.typekit.net" crossorigin />
        <link rel="stylesheet" href={`https://use.typekit.net/${site.adobeFontsKit}.css`} />
      </>
    )}
    <meta name="theme-color" content="#f3f3f3" />
    <slot name="head" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body class:list={{ 'has-degular': !!site.adobeFontsKit }}>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <a href="/" class="home" aria-label="Dan and Marc, home"><Wordmark size="20px" /></a>
      <button class="menu-btn" type="button" aria-expanded="false" aria-controls="site-nav">
        <span class="sr-only">Menu</span><span class="bars" aria-hidden="true"></span>
      </button>
      <nav id="site-nav" aria-label="Main">
        <ul>
          {site.nav.map((n) => (
            <li><a href={n.href} aria-current={isActive(n.href) ? 'page' : undefined}>{n.label}</a></li>
          ))}
        </ul>
      </nav>
    </header>

    <main id="main"><slot /></main>

    <script>
      const btn = document.querySelector<HTMLButtonElement>('.menu-btn')!;
      const set = (open: boolean) => {
        btn.setAttribute('aria-expanded', String(open));
        document.documentElement.classList.toggle('menu-open', open);
      };
      btn.addEventListener('click', () => set(btn.getAttribute('aria-expanded') !== 'true'));
      document.addEventListener('keydown', (e) => e.key === 'Escape' && set(false));
      matchMedia('(min-width: 641px)').addEventListener('change', () => set(false));
    </script>

  </body>
</html>

<style>
  .site-header {
    position: absolute; top: 0; left: 0; right: 0; z-index: 50;
    display: flex; align-items: center; justify-content: space-between; gap: 1rem;
    height: 43px; padding-inline: 25px var(--pad);
  }
  .home { color: var(--ink); }
  .home:hover { opacity: 1; }
  nav ul { display: flex; gap: 20px; list-style: none; margin: 0; padding: 0; }
  nav a {
    font-family: var(--display);
    font-size: 14.7px; font-weight: 700; letter-spacing: 0.11em; text-transform: uppercase;
  }
  nav a[aria-current='page'] { text-decoration: underline; text-underline-offset: 4px; text-decoration-thickness: 1.5px; }


  /* Degular is narrower than the fallback; don't over-tighten it */
  :global(body.has-degular) { --display-tracking: 0em; --text-tracking: 0em; }

  .menu-btn { display: none; }

  @media (max-width: 640px) {
    .site-header { height: 57px; padding-inline: 13px 16px; }
    .home { position: relative; z-index: 2; }
    .menu-btn {
      position: relative; z-index: 2; display: block; width: 36px; height: 36px; margin-right: -4px;
      background: none; border: 0; padding: 0; cursor: pointer; color: var(--ink);
    }
    .bars, .bars::before {
      position: absolute; left: 1px; right: 1px; height: 1.5px; background: currentColor;
      transition: transform 0.25s ease, top 0.25s ease;
    }
    .bars { top: 13px; }
    .bars::before { content: ''; left: 0; right: 0; top: 8px; }
    :global(.menu-open) .bars { top: 17px; transform: rotate(45deg); }
    :global(.menu-open) .bars::before { top: 0; transform: rotate(-90deg); }

    nav {
      position: fixed; inset: 0; z-index: 1; background: var(--bg);
      display: flex; align-items: center; justify-content: center;
      opacity: 0; visibility: hidden; transition: opacity 0.25s ease, visibility 0s 0.25s;
    }
    :global(.menu-open) nav { opacity: 1; visibility: visible; transition: opacity 0.25s ease; }
    :global(.menu-open) body { overflow: hidden; }
    nav ul { flex-direction: column; align-items: center; gap: 1.6rem; }
    nav a { font-size: 22px; }
  }
</style>
