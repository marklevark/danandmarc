---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const order = ['international', 'canadian'];
const regions = (await getCollection('awards'))
  .sort((a, b) => order.indexOf(a.id) - order.indexOf(b.id))
  .map((r) => r.data);
---
<Base title="Awards" description="Some say a list of all your awards is a bit overkill. Anyways, here's ours.">
  <div class="page">
    <h1>Some say a list of all your awards is a bit overkill. Anyways, here’s ours:</h1>
    <div class="regions">
      {regions.map((r) => (
        <section>
          <h2>{r.region}</h2>
          {r.shows.map((s) => (
            <div class="show">
              <p><strong>{s.show}</strong>{s.tally && ` (${s.tally})`}</p>
              <ul>
                {s.entries.map((e) => <li>{e.year ? `${e.year} - ` : ''}{e.award}</li>)}
              </ul>
            </div>
          ))}
        </section>
      ))}
    </div>
  </div>
</Base>

<style>
  h1 { font-size: var(--fs-hero); line-height: 0.8; max-width: 7.6em; padding-top: clamp(96px, 29vw, 425px); }
  .regions { display: grid; gap: 40px 3rem; grid-template-columns: 1fr; padding-top: 36px; }
  h2 { font-size: var(--fs-title); line-height: 0.83; margin-bottom: 1.6rem; }
  .regions section:last-child h2 { margin-top: 0; }
  .show { margin-bottom: 1.6rem; }
  .show p { margin-bottom: 1.1em; }
  strong { font-weight: 700; }
  ul { list-style: none; margin: 0; padding: 0; }
  @media (min-width: 768px) {
    .regions { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
