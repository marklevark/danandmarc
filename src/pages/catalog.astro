---
/**
 * Alternate homepage, styled after a merch-catalogue layout (big condensed headline,
 * light-grey product cards, small bold uppercase UI type).
 * Display font: Anton (free stand-in for a heavy condensed grotesk). UI font: the site's Inter Tight.
 */
import '@fontsource/anton/400.css';
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { getWork } from '../lib/work';
import { site } from '../data/site';

// Same order as the main work grid (the `order` field in each project file)
const work = await getWork();

const items = await Promise.all(
  work.map(async (w) => {
    const d = w.data;
    const key = d.keyImage ?? d.cover;
    const img = await getImage({ src: key, width: 900, format: 'webp', quality: 80 });
    const agencies = [
      ...new Set([d.agency, ...d.blocks.flatMap((b) => ('credits' in b && b.credits.agency ? [b.credits.agency] : []))].filter(Boolean) as string[]),
    ];
    return {
      slug: w.id,
      title: d.title,
      client: d.client ?? (agencies.length > 1 ? 'Various' : d.agency ?? ''),
      agencies,
      when: d.years ?? (d.year ? String(d.year) : ''),
      src: img.src,
    };
  }),
);

// Two wide "feature" cards break up the grid, like the reference.
const FEATURE = new Set(['unignorable', 'the-unignorable-tower']);
---
<Base title="Work" description="Dan and Marc: all the work.">
  <meta name="robots" content="noindex" slot="head" />

  <div class="cx-dock">
    <nav class="cx-pill" aria-label="Main">
      <details class="cx-menu">
        <summary aria-label="Menu"><span class="cx-burger" aria-hidden="true"></span></summary>
        <ul>
          {site.nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
        </ul>
      </details>
      <a class="cx-logo" href="/catalog">Dan&amp;Marc</a>
      <a class="cx-icon" href={`mailto:${site.email}`} aria-label="Email us">
        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5.5" width="18" height="13" rx="1.5" /><path d="m3.5 6.5 8.5 6.5 8.5-6.5" /></svg>
      </a>
    </nav>
    <a class="cx-bar" href={`mailto:${site.email}`}>
      <span>Say hi</span>
      <span aria-hidden="true">→</span>
    </a>
  </div>

  <div class="cx">
    <header class="cx-head">
      <h1>All work</h1>
    </header>

    <ul class="cx-grid">
      {items.map((it, i) => (
        <li class:list={['cx-item', { wide: FEATURE.has(it.slug) }]}>
          <a href={`/work/${it.slug}`} class="cx-card">
            <span class="cx-tile">
              <img src={it.src} alt="" loading={i < 4 ? 'eager' : 'lazy'} decoding="async" />
            </span>
            <span class="cx-name">{it.title}</span>
            <span class="cx-sub">{it.client}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>

  <section class="cx-foot">
    <h2>Say hi</h2>
    <ul>
      <li><span>Both of us</span><a href={`mailto:${site.email}`}>{site.email}</a></li>
      {site.people.map((p) => <li><span>Just {p.first}</span><a href={`mailto:${p.email}`}>{p.email}</a></li>)}
    </ul>
  </section>
</Base>

<script>
  // close the menu when clicking elsewhere
  const menu = document.querySelector<HTMLDetailsElement>('.cx-menu')!;
  document.addEventListener('click', (e) => { if (!menu.contains(e.target as Node)) menu.open = false; });
</script>

<style>
  /* White page, black type; hide the regular site header on this page */
  :global(body) { --bg: #fff; --ink: #000; --muted: #6b6b6b; --tile: #f2f2f2; }
  :global(.site-header) { display: none !important; }
  :global(main) { padding-bottom: 0 !important; }

  .cx, .cx-foot { --cond: 'Anton', 'Impact', 'Arial Narrow', sans-serif; }
  .cx-dock { --cond: 'Anton', 'Impact', 'Arial Narrow', sans-serif; }

  /* small UI type: bold, uppercase, tight */
  .cx-bar, .cx-menu a {
    font-family: var(--text); font-weight: 700; font-size: 12px; line-height: 1;
    letter-spacing: -0.01em; text-transform: uppercase;
  }

  /* ---------- floating nav pill + black bar ---------- */
  .cx-dock {
    position: fixed; z-index: 60; top: 36px; left: 50%; transform: translateX(-50%);
    width: min(350px, calc(100vw - 40px));
  }
  .cx-pill {
    position: relative; display: grid; grid-template-columns: 40px 1fr 40px; align-items: center;
    height: 50px; padding: 0 6px; background: #fff; border: 1px solid #e6e6e6;
  }
  .cx-menu summary { list-style: none; display: grid; place-items: center; width: 40px; height: 40px; cursor: pointer; }
  .cx-menu summary::-webkit-details-marker { display: none; }
  .cx-burger, .cx-burger::before { display: block; width: 24px; height: 1.5px; background: #000; position: relative; }
  .cx-burger { top: -3px; }
  .cx-burger::before { content: ''; top: 6px; }
  .cx-menu ul {
    position: absolute; left: -1px; right: -1px; top: 100%; z-index: 2; list-style: none; margin: 0; padding: 8px 0;
    background: #fff; border: 1px solid #e6e6e6; border-top: 0;
  }
  .cx-menu a { display: block; padding: 12px 16px; }
  .cx-logo {
    justify-self: start; padding-left: 6px;
    font-family: var(--cond); font-size: 24px; line-height: 1; letter-spacing: 0.01em; text-transform: uppercase;
  }
  .cx-icon { justify-self: end; display: grid; place-items: center; width: 40px; height: 40px; }
  .cx-icon svg { width: 20px; height: 20px; fill: none; stroke: #000; stroke-width: 1.5; }
  .cx-bar {
    display: flex; justify-content: space-between; align-items: center;
    height: 50px; padding: 0 16px; background: #000; color: #fff;
  }
  .cx-bar:hover, .cx-logo:hover, .cx-icon:hover { opacity: 1; }
  .cx-bar:hover span:last-child { transform: translateX(3px); }
  .cx-bar span:last-child { transition: transform 0.15s ease; }

  /* ---------- headline ---------- */
  .cx { padding: 0 30px; }
  .cx-head {
    display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 20px 40px;
    padding-top: clamp(170px, 19vw, 270px); padding-bottom: clamp(30px, 4.5vw, 70px);
  }
  /* Anton sized so its cap height matches the reference's 160px headline (Anton caps run ~15% taller) */
  h1, .cx-foot h2 {
    margin: 0; font-family: var(--cond); font-weight: 400; text-transform: uppercase;
    font-size: clamp(66px, 9.7vw, 140px); line-height: 0.92; letter-spacing: -0.005em; word-spacing: -0.04em;
  }
  .cx-card:focus-visible { outline: 2px solid #000; outline-offset: 3px; }

  /* ---------- product-style grid ---------- */
  .cx-grid { list-style: none; margin: 0; padding: 0; display: grid; gap: 30px 4px; grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .cx-item.wide { grid-column: span 2; }
  .cx-card { display: block; text-align: center; }
  .cx-card:hover { opacity: 1; }
  .cx-tile {
    position: relative; display: grid; place-items: center; aspect-ratio: 1;
    padding: 11%; overflow: hidden; border-radius: 6px; background: var(--tile);
  }
  /* a wide card is exactly two tiles + the gap wide, and one tile tall */
  .wide .cx-tile { aspect-ratio: auto; height: calc((100% - 4px) / 2); }
  .cx-item.wide .cx-tile { aspect-ratio: 2.012; height: auto; padding: 8% 18%; }
  .cx-tile img {
    width: 100%; height: auto; max-height: 100%; object-fit: contain;
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.12); transition: transform 0.35s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .cx-card:hover .cx-tile img { transform: scale(1.04); }
  .cx-name {
    display: block; margin-top: 22px; font-size: 14px; line-height: 1.2; letter-spacing: -0.01em; text-transform: uppercase;
  }
  .cx-sub { display: block; margin-top: 2px; font-size: 14px; line-height: 1.2; color: var(--muted); }

  /* ---------- black footer block ---------- */
  .cx-foot { margin-top: 110px; padding: 60px 30px 70px; background: #000; color: #fff; }
  .cx-foot h2 { font-size: clamp(50px, 6.1vw, 96px); }
  .cx-foot ul { list-style: none; margin: 32px 0 0; padding: 0; display: grid; gap: 10px; }
  .cx-foot li { display: flex; flex-wrap: wrap; gap: 4px 18px; align-items: baseline; text-transform: uppercase; font-size: 14px; }
  .cx-foot li span { min-width: 110px; color: #8a8a8a; font-weight: 700; font-size: 12px; }
  .cx-foot a { font-family: var(--cond); font-size: clamp(24px, 2.6vw, 38px); letter-spacing: 0.01em; text-transform: uppercase; }

  /* ---------- responsive ---------- */
  @media (max-width: 1000px) {
    .cx-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .cx-item.wide { grid-column: auto; }
    .cx-item.wide .cx-tile { aspect-ratio: 1; padding: 11%; }
  }
  @media (max-width: 700px) {
    .cx { padding: 0 20px; }
    .cx-dock { top: 20px; }
    .cx-head { padding-top: 150px; flex-direction: column; align-items: flex-start; gap: 18px; }
      .cx-grid { gap: 26px 6px; }
    .cx-tile { padding: 12%; }
    .cx-name { margin-top: 14px; font-size: 12px; }
    .cx-sub { font-size: 12px; }
    .cx-foot { padding: 44px 20px 54px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .cx-tile img, .cx-bar span:last-child { transition: none; }
  }
</style>
