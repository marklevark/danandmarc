---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { site, roster } from '../data/site';
import portrait from '../assets/about/saty-pratha_23-portrait_2281--1-.jpg';
const [dan, marc] = site.people;
---
<Base title="Contact" description="Dan is Dan Cantelon and Marc is Marc Levesque. A freelance creative team with a combined 25+ years of industry experience.">
  <section class="contact page">
    <div class="copy">
      <h1>Dan is Dan Cantelon and<br />Marc is Marc Levesque.</h1>
      <p>
        We’re an award-winning freelance creative team with a combined 25+ years of industry experience,
        as well as a combined height of 12'5". We’ve spent our careers working at top-tier agencies,
        creating strategic and results-driven work across all disciplines. Our work has been recognized
        at every major international and national award show.
      </p>
      <p>
        Here are some of the agencies we’ve worked at and clients we’ve worked on in absolutely no order
        at all: {roster.join(', ')}, and more!
      </p>
      <p class="hi">
        Say hi to both of us: <a href={`mailto:${site.email}`}>{site.email}</a><br />
        Say hi to just {dan.first}: <a href={`mailto:${dan.email}`}>{dan.email}</a><br />
        Say hi to just {marc.first}: <a href={`mailto:${marc.email}`}>{marc.email}</a><br />
        Say hi to neither:
      </p>
    </div>
    <figure>
      <Image src={portrait} alt="Dan Cantelon and Marc Levesque" widths={[480, 800, 1200]} sizes="(min-width: 768px) 46vw, 100vw" loading="eager" />
      <figcaption>📷: <a href="https://www.satyandpratha.org" rel="noopener" target="_blank">Saty+Pratha</a></figcaption>
    </figure>
  </section>
</Base>

<style>
  .contact {
    display: grid; gap: 40px 3rem; grid-template-columns: 1fr; align-items: center;
    padding-top: clamp(96px, 12vw, 178px);
  }
  h1 { font-size: var(--fs-title); line-height: 0.83; margin-bottom: 2rem; }
  .copy { max-width: 41rem; }
  .hi a { font-weight: 700; }
  figure { margin: 0; }
  figure :global(img) { width: 100%; height: auto; }
  figcaption { margin-top: 0.6rem; text-align: center; font-size: 13px; }
  figcaption a { text-decoration: underline; text-underline-offset: 2px; }
  @media (min-width: 768px) {
    .contact { grid-template-columns: minmax(0, 1fr) minmax(0, 0.92fr); padding-right: 50px; }
  }
</style>
