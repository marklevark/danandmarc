---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { site, roster } from '../data/site';
import portrait from '../assets/about/saty-pratha_23-portrait_2281--1-.jpg';
---
<Base title="Contact" description="Dan is Dan Cantelon and Marc is Marc Levesque. A freelance creative team with a combined 25+ years of industry experience.">
  <section class="wrap about">
    <div class="copy">
      <h1>Dan is Dan Cantelon and Marc is Marc Levesque.</h1>
      <p class="lede">
        We’re an award-winning freelance creative team with a combined 25+ years of industry experience,
        as well as a combined height of 12'5". We’ve spent our careers working at top-tier agencies,
        creating strategic and results-driven work across all disciplines. Our work has been recognized
        at every major international and national award show.
      </p>
    </div>
    <figure class="photo">
      <Image src={portrait} alt="Dan Cantelon and Marc Levesque" widths={[480, 800, 1200]} sizes="(min-width: 860px) 40vw, 100vw" loading="eager" />
      <figcaption>📷 <a href="https://www.satyandpratha.org" rel="noopener" target="_blank">Saty+Pratha</a></figcaption>
    </figure>
  </section>

  <section class="wrap hi" aria-labelledby="hi-h">
    <h2 id="hi-h" class="eyebrow">Say hi</h2>
    <ul class="mail">
      <li><span>To both of us</span><a href={`mailto:${site.email}`}>{site.email}</a></li>
      {site.people.map((p) => (
        <li><span>To just {p.first}</span><a href={`mailto:${p.email}`}>{p.email}</a></li>
      ))}
      <li class="neither"><span>To neither</span><em>(you can just close the tab)</em></li>
    </ul>
  </section>

  <section class="wrap roster" aria-labelledby="roster-h">
    <h2 id="roster-h" class="eyebrow">Agencies we’ve worked at and clients we’ve worked on, in absolutely no order at all</h2>
    <ul>
      {roster.map((r) => <li>{r}</li>)}
      <li class="more">and more!</li>
    </ul>
  </section>
</Base>

<style>
  .about {
    display: grid; gap: clamp(2rem, 5vw, 4rem); align-items: end;
    padding-block: clamp(2.5rem, 8vw, 6rem) clamp(2rem, 5vw, 4rem);
  }
  h1 { font-size: var(--step-4); letter-spacing: -0.05em; line-height: 0.92; max-width: 13ch; }
  .lede { margin-top: clamp(1.5rem, 3vw, 2.5rem); font-size: var(--step-1); max-width: 46ch; }
  .photo { margin: 0; }
  .photo :global(img) { width: 100%; height: auto; border-radius: var(--radius); }
  figcaption { margin-top: 0.5rem; font-size: var(--step--1); color: var(--muted); }
  @media (min-width: 860px) { .about { grid-template-columns: 1.4fr 1fr; } }

  .hi, .roster { margin-top: clamp(2.5rem, 7vw, 5rem); }
  .hi .eyebrow, .roster .eyebrow { padding-bottom: 0.75rem; border-bottom: 1px solid var(--line); margin-bottom: 0.5rem; }
  .mail { list-style: none; margin: 0; padding: 0; }
  .mail li {
    display: grid; gap: 0.25rem 2rem; align-items: baseline;
    padding-block: clamp(0.75rem, 2vw, 1.25rem); border-bottom: 1px solid var(--line);
  }
  .mail span { color: var(--muted); font-weight: 600; }
  .mail a, .mail em {
    font-size: var(--step-3); font-weight: 800; letter-spacing: -0.04em; line-height: 1.05;
    text-decoration: none; overflow-wrap: anywhere;
  }
  .mail em { font-style: normal; color: var(--muted); font-size: var(--step-2); font-weight: 600; }
  @media (min-width: 860px) { .mail li { grid-template-columns: 12rem 1fr; } }

  .roster ul { list-style: none; margin: 1rem 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.25rem 0; }
  .roster li { font-size: var(--step-2); font-weight: 700; letter-spacing: -0.03em; line-height: 1.25; }
  .roster li:not(:last-child)::after { content: '·'; margin-inline: 0.45em; color: var(--accent); }
  .roster .more { color: var(--muted); }
</style>
