---
/**
 * Homepage. Dark "night" theme is the site default (near-black #010101, off-white #fbefe0, Outfit
 * headlines, Figtree body). The old light version lives at /light. Theme tokens live in global.css.
 */
import Base from '../layouts/Base.astro';
import WorkCard from '../components/WorkCard.astro';
import Swap from '../components/Swap.astro';
import { getWork } from '../lib/work';

const work = await getWork();
---
<Base>
  <section class="hero page">
    <h1>We’re <span class="nw"><Swap a="Dan & Marc" b="Marc & Dan" />.</span><br /><span class="nw">But you can call us</span><br /><span class="nw"><Swap a="Marc & Dan" b="Dan & Marc" />.</span></h1>
    <p>We’re an award-winning freelance creative team based out of Toronto.</p>
  </section>

  <h2 class="sr-only">Work</h2>
  <ul class="grid">
    {work.map((entry, i) => (
      <li><WorkCard entry={entry} eager={i < 3} /></li>
    ))}
  </ul>
</Base>

<style>
  .nw { white-space: nowrap; }
  .hero { padding-top: clamp(64px, 23.5vw, 340px); padding-bottom: 14px; }
  h1 { font-size: calc(var(--fs-hero) * 0.8 * var(--hd-scale, 1)); line-height: var(--hd-lh, 0.88); max-width: 9em; }
  .hero p { margin-top: 0.9rem; font-size: var(--fs-lead); }

  .grid {
    list-style: none; margin: 0; padding: 0 var(--pad);
    display: grid; gap: 0; grid-template-columns: 1fr;
  }
  /* thumbnails butt up against each other: no gaps, square corners */
  .grid :global(.card) { border-radius: 0; }
  .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  @media (min-width: 768px) { .grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (min-width: 1100px) { .grid { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
</style>
