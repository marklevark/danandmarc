---
import Base from '../layouts/Base.astro';
import WorkCard from '../components/WorkCard.astro';
import Swap from '../components/Swap.astro';
import { getWork } from '../lib/work';

const work = await getWork();
---
<Base>
  <section class="hero page">
    <h1>We’re <Swap a="Dan and Marc" b="Marc and Dan" />.<br />But you can call us <Swap a="Marc and Dan" b="Dan and Marc" />.</h1>
    <p>We’re an award-winning freelance creative team based out of Toronto.</p>
  </section>

  <h2 class="sr-only">Work</h2>
  <ul class="grid">
    {work.map((entry, i) => (
      <li><WorkCard entry={entry} eager={i < 3} /></li>
    ))}
  </ul>
</Base>

<style>
  .hero { padding-top: clamp(64px, 23.5vw, 340px); padding-bottom: 14px; }
  h1 { font-size: var(--fs-hero); line-height: 0.8; max-width: 9em; }
  .hero p { margin-top: 0.9rem; font-size: var(--fs-lead); }

  .grid {
    list-style: none; margin: 0; padding: 0 var(--pad);
    display: grid; gap: var(--gap); grid-template-columns: 1fr;
  }
  @media (min-width: 768px) { .grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
</style>
