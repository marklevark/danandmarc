import { getImage } from 'astro:assets';
import sharp from 'sharp';
import Base from '../layouts/Base.astro';
import { getWork } from '../lib/work';

const STEP = 6; // px each pinned card sits below the previous one (12 in the original; 13 cards here)

/**
 * Card colour = the most vivid colour that covers a real share of the cover image
 * (blacks, whites and greys only win if the image has nothing else). Ink = black or white for contrast.
 */
async function palette(file: string | undefined) {
  const fallback = { bg: '#eeece6', ink: '#1b1b1b' };
  if (!file) return fallback;
  try {
    const { data, info } = await sharp(file).resize(64, 64, { fit: 'inside' }).removeAlpha().raw()
      .toBuffer({ resolveWithObject: true });
    const buckets = new Map<number, { n: number; r: number; g: number; b: number }>();
    for (let i = 0; i < data.length; i += info.channels) {
      const r = data[i], g = data[i + 1], b = data[i + 2];
      const key = ((r >> 4) << 8) | ((g >> 4) << 4) | (b >> 4);
      const k = buckets.get(key) ?? { n: 0, r: 0, g: 0, b: 0 };
      k.n++; k.r += r; k.g += g; k.b += b;
      buckets.set(key, k);
    }
    const total = data.length / info.channels;
    let best: { score: number; r: number; g: number; b: number } | undefined;
    for (const k of buckets.values()) {
      const r = k.r / k.n, g = k.g / k.n, b = k.b / k.n;
      const max = Math.max(r, g, b) / 255, min = Math.min(r, g, b) / 255;
      const l = (max + min) / 2;
      const sat = max === min ? 0 : (max - min) / (1 - Math.abs(2 * l - 1));
      const share = k.n / total;
      if (share < 0.01) continue;
      const tone = l < 0.12 || l > 0.9 ? 0.15 : 1; // near-black / near-white only as a last resort
      const score = share * tone * (0.15 + sat) ** 2;
      if (!best || score > best.score) best = { score, r, g, b };
    }
    if (!best) return fallback;
    const c = [best.r, best.g, best.b].map(Math.round);
    const hex = '#' + c.map((v) => v.toString(16).padStart(2, '0')).join('');
    const lin = (v: number) => ((v /= 255) <= 0.03928 ? v / 12.92 : ((v + 0.055) / 1.055) ** 2.4);
    const L = 0.2126 * lin(c[0]) + 0.7152 * lin(c[1]) + 0.0722 * lin(c[2]);
    return { bg: hex, ink: L > 0.22 ? '#141414' : '#f4f2ec' };
  } catch {
    return fallback;
  }
}

const work = (await getWork()).sort(
  (a, b) => (b.data.year ?? 0) - (a.data.year ?? 0) || a.data.order - b.data.order,
);
const cards = await Promise.all(
  work.map(async (w) => {
    const d = w.data;
    const key = d.keyImage ?? d.cover;
    const img = await getImage({ src: key, width: 1800, format: 'webp', quality: 80 });
    const { bg, ink } = await palette((key as unknown as { fsPath?: string }).fsPath);
    return {
      slug: w.id,
      title: d.title,
      client: d.client ?? d.agency ?? '',
      agency: d.client && d.agency && d.agency !== d.client ? d.agency : '',
      when: d.years ?? (d.year ? String(d.year) : ''),
      src: img.src,
      pos: d.keyImage ? '50% 50%' : d.coverPosition,
      bg,
      ink,
    };
  }),
);
const N = cards.length;
const pad = (n: number) => String(n).padStart(2, '0');
---
<Base title="Work" description="Dan and Marc: selected work, newest first.">
  <meta name="robots" content="noindex" slot="head" />
  <section class="fs" aria-label="Selected work">
    <div class="fs-list">
      {cards.map((c, i) => (
        <>
          <span class="fs-anchor" aria-hidden="true" />
          <article class="fs-slot" style={`top:${10 + i * STEP}px;z-index:${i + 1}`}>
            <a class="fs-cover" href={`/work/${c.slug}`} style={`--bg:${c.bg};--ink:${c.ink}`}>
              <div class="fs-meta">
                <span>{c.client}{c.agency && ` / ${c.agency}`}</span>
                <span>Nº {pad(i + 1)}</span>
              </div>
              <strong>{c.title}</strong>
              <span class="fs-edition">{c.when} · View project →</span>
              <span class="fs-art">
                <img src={c.src} alt="" loading={i < 2 ? 'eager' : 'lazy'} decoding="async" style={`object-position:${c.pos}`} />
              </span>
            </a>
          </article>
        </>
      ))}
      <div class="fs-tail" />
    </div>

    <button class="fs-next" type="button" aria-label="Next project">↓</button>
  </section>
</Base>

<script>
  const STEP = 6;
  const BAR = 0;
  const slots = [...document.querySelectorAll<HTMLElement>('.fs-slot')];
  const anchors = [...document.querySelectorAll<HTMLElement>('.fs-anchor')];
  const covers = slots.map((s) => s.firstElementChild as HTMLElement);
  const next = document.querySelector<HTMLButtonElement>('.fs-next')!;
  const N = slots.length;

  const mq = matchMedia('(prefers-reduced-motion: reduce)');
  let reduced = mq.matches;
  let page = -1;

  const anchorY = (i: number) => anchors[i].getBoundingClientRect().top + scrollY;

  // Recede: as the next card's top approaches the pinned card, scale it down and dim it.
  const update = () => {
    const h = innerHeight;
    let selected = 0;
    for (let i = 0; i < N; i++) {
      const top = i < N - 1 ? anchors[i + 1].getBoundingClientRect().top : h;
      const depth = i < N - 1 ? Math.max(0, Math.min(1, (h - 30 - top) / (h - 55))) : 0;
      covers[i].style.transform = reduced ? '' : `scale(${1 - depth * 0.09})`;
      covers[i].style.filter = reduced || depth === 0 ? '' : `brightness(${1 - depth * 0.2})`;
      if (scrollY >= anchorY(i) - BAR - i * STEP - 20) selected = i;
    }
    if (selected !== page) {
      page = selected;
      const last = selected === N - 1;
      next.textContent = last ? '↑' : '↓';
      next.setAttribute('aria-label', last ? 'Back to the newest project' : 'Next project');
    }
  };

  let queued = false;
  const schedule = () => {
    if (queued) return;
    queued = true;
    requestAnimationFrame(() => { queued = false; update(); });
  };
  addEventListener('scroll', schedule, { passive: true });
  addEventListener('resize', schedule);
  mq.addEventListener('change', () => { reduced = mq.matches; update(); });
  update();

  next.addEventListener('click', (e) => {
    const target = (page + 1) % N;
    scrollTo({
      top: anchorY(target) - BAR - 10 - target * STEP,
      behavior: !reduced && e.detail !== 0 ? 'smooth' : 'instant',
    });
  });
</script>

<style>
  /* Dark slate page like the original; header/nav pick up the light ink */
  :global(body) { --bg: #262a30; --ink: #eceae4; --muted: #9aa0a6; }
  :global(main) { padding-bottom: 0 !important; }

  .fs { position: relative; padding-top: 43px; }

  .fs-list { padding: 0 var(--pad); }
  .fs-anchor { display: block; height: 0; width: 0; }
  .fs-slot { position: sticky; height: calc(100svh - 70px); min-height: 380px; margin-bottom: 26px; }

  /* Card: folio layout. Huge title across the top, landscape image bottom-right, year bottom-left */
  .fs-cover {
    display: grid; position: relative; height: 100%; overflow: hidden;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: auto auto minmax(0, 1fr) auto;
    grid-template-areas: 'meta' 'title' 'art' 'edition';
    gap: clamp(12px, 1.4vw, 22px);
    padding: clamp(14px, 1.8vw, 28px);
    background: var(--bg); color: var(--ink); transform-origin: 50% 0;
    box-shadow: 0 3px 7px rgba(0, 0, 0, 0.2); will-change: transform, filter;
  }
  .fs-cover:hover { opacity: 1; }
  .fs-cover:focus-visible { outline: 2px solid #fff; outline-offset: -4px; }

  .fs-meta {
    grid-area: meta; display: flex; justify-content: space-between; gap: 1rem;
    font: 500 clamp(10px, 0.85vw, 12px)/1.3 ui-monospace, 'SF Mono', Menlo, monospace;
    letter-spacing: 0.08em; text-transform: uppercase;
  }
  strong {
    grid-area: title; display: block;
    font-family: var(--display); font-weight: 900; font-size: clamp(40px, 7.2vw, 136px);
    line-height: 0.84; letter-spacing: -0.055em; text-transform: uppercase; text-wrap: balance;
  }
  .fs-edition {
    grid-area: edition; align-self: end;
    font: 500 clamp(9px, 0.8vw, 12px)/1 ui-monospace, 'SF Mono', Menlo, monospace;
    letter-spacing: 0.1em; text-transform: uppercase;
  }
  .fs-art { grid-area: art; position: relative; min-height: 0; overflow: hidden; background: rgba(0, 0, 0, 0.12); }
  .fs-art img {
    position: absolute; inset: 0; width: 100%; height: 100%; max-width: none; object-fit: cover;
    transition: transform 0.5s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .fs-cover:hover .fs-art img { transform: scale(1.03); }

  .fs-tail { height: 30vh; }

  .fs-next {
    position: fixed; right: 16px; bottom: 16px; z-index: 200;
    width: 52px; height: 52px; border-radius: 50%; border: 1px solid rgba(255, 255, 255, 0.18);
    background: #262a30; color: #eee; font: 24px/1 Arial, sans-serif; cursor: pointer;
    transition: background 0.15s ease;
  }
  .fs-next:hover { background: #343941; }
  .fs-next:focus-visible { outline: 2px solid #fff; outline-offset: 3px; }

  @media (max-width: 899px) {
    /* Phones/tablets: keep the image landscape; the card sizes to its content */
    .fs-slot { height: auto; min-height: 0; }
    .fs-cover { grid-template-rows: auto auto auto auto; }
    .fs-art { aspect-ratio: 16 / 10; }
  }
  @media (max-width: 700px) {
    strong { font-size: clamp(34px, 11.5vw, 60px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .fs-art img { transition: none; }
  }
</style>
