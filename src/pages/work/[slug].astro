---
import { getImage } from 'astro:assets';
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import Blocks from '../../components/Blocks.astro';
import { getWork } from '../../lib/work';
import { paragraphs } from '../../lib/text';

export const getStaticPaths = (async () => {
  const work = await getWork();
  return work.map((entry, i) => ({
    params: { slug: entry.id },
    props: {
      entry,
      prev: work[(i - 1 + work.length) % work.length],
      next: work[(i + 1) % work.length],
    },
  }));
}) satisfies GetStaticPaths;

const { entry, prev, next } = Astro.props;
const d = entry.data;
const firstText = d.blocks.find((b) => 'text' in b) as { text: string } | undefined;
const description = firstText ? firstText.text.split('\n')[0].slice(0, 155) : undefined;
const og = await getImage({ src: d.cover, width: 1200, format: 'jpg' });
---
<Base title={d.title} description={description} image={og.src}>
  <article class="page">
    <Blocks entry={entry} />

    {d.awards?.length ? (
      <section class="extra">
        <h2>Awards</h2>
        <dl class="awards">
          {d.awards.map((a) => <div><dt>{a.show}</dt><dd>{a.result}</dd></div>)}
        </dl>
      </section>
    ) : null}
    {d.press && (
      <section class="extra">
        <h2>PR</h2>
        <div>{paragraphs(d.press).map((p) => <p set:html={p} />)}</div>
      </section>
    )}

    <nav class="pager" aria-label="More work">
      <a href={`/work/${prev.id}`} rel="prev"><span aria-hidden="true">←</span> {prev.data.title}</a>
      <a href={`/work/${next.id}`} rel="next">{next.data.title} <span aria-hidden="true">→</span></a>
    </nav>
  </article>
</Base>

<style>
  .extra {
    display: grid; gap: 1rem 3rem; grid-template-columns: 1fr; padding-top: 60px;
  }
  .extra h2 { font-size: var(--fs-lead); line-height: 1; }
  .extra > div, .awards { max-width: 37rem; }
  .awards { margin: 0; display: grid; gap: 0.35rem; }
  .awards div { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 1rem; }
  .awards dd { margin: 0; }

  .pager {
    display: flex; justify-content: space-between; gap: 1rem; flex-wrap: wrap;
    padding-top: 90px;
    font-family: var(--display); font-weight: 700; font-size: var(--fs-lead);
    letter-spacing: var(--display-tracking);
  }
  @media (min-width: 768px) {
    .extra { grid-template-columns: minmax(0, 1.65fr) minmax(0, 1fr); }
  }
</style>
