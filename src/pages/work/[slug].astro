---
import { getImage } from 'astro:assets';
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import Blocks from '../../components/Blocks.astro';
import { getWork } from '../../lib/work';
import { paragraphs } from '../../lib/text';

export const getStaticPaths = (async () => {
  const work = await getWork();
  return work.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, next: work[(i + 1) % work.length], index: i },
  }));
}) satisfies GetStaticPaths;

const { entry, next, index } = Astro.props;
const d = entry.data;
const firstText = d.blocks.find((b) => 'text' in b) as { text: string } | undefined;
const description = firstText ? firstText.text.split('\n')[0].slice(0, 155) : undefined;
const og = await getImage({ src: d.cover, width: 1200, format: 'jpg' });
const credits = [
  ['Agency', d.agency],
  ['Client', d.client],
  ['Role', d.role],
].filter(([, v]) => v) as [string, string][];
---
<Base title={d.title} description={description} image={og.src}>
  <article>
    <header class="wrap head">
      <p class="eyebrow"><a href="/">Work</a> <span aria-hidden="true">/</span> {String(index + 1).padStart(2, '0')}</p>
      <h1>{d.title}</h1>
      {credits.length > 0 && (
        <dl class="credits">
          {credits.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
        </dl>
      )}
    </header>

    <div class="wrap body">
      <Blocks entry={entry} />
    </div>

    {(d.awards?.length || d.press) && (
      <aside class="wrap recog" aria-label="Recognition">
        {d.awards?.length ? (
          <section>
            <h2 class="eyebrow">Awards</h2>
            <dl class="awards">
              {d.awards.map((a) => <div><dt>{a.show}</dt><dd>{a.result}</dd></div>)}
            </dl>
          </section>
        ) : null}
        {d.press && (
          <section>
            <h2 class="eyebrow">Press</h2>
            <div class="press">{paragraphs(d.press).map((p) => <p set:html={p} />)}</div>
          </section>
        )}
      </aside>
    )}

    <nav class="wrap next" aria-label="Next project">
      <a href={`/work/${next.id}`}>
        <span class="eyebrow">Next</span>
        <span class="next-title">{next.data.title} <span aria-hidden="true">→</span></span>
      </a>
    </nav>
  </article>
</Base>

<style>
  .head { padding-block: clamp(2.5rem, 8vw, 6rem) clamp(2rem, 5vw, 4rem); }
  .head .eyebrow a { text-decoration: none; }
  h1 { font-size: var(--step-4); margin-top: 0.75rem; max-width: 16ch; letter-spacing: -0.05em; line-height: 0.92; }
  .credits { display: flex; flex-wrap: wrap; gap: 0.75rem 3rem; margin: clamp(1.5rem, 3vw, 2.5rem) 0 0; }
  dt { font-size: var(--step--1); color: var(--muted); font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; }
  dd { margin: 0; font-weight: 700; font-size: var(--step-1); }

  .recog {
    display: grid; gap: 2.5rem; margin-top: clamp(3rem, 8vw, 6rem);
    padding-top: clamp(1.5rem, 3vw, 2rem); border-top: 1px solid var(--line);
  }
  .recog .eyebrow { margin-bottom: 1rem; }
  .awards { margin: 0; display: grid; }
  .awards div {
    display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 1rem;
    padding-block: 0.6rem; border-bottom: 1px solid var(--line);
  }
  .awards dt { text-transform: none; letter-spacing: 0; font-size: var(--step-0); color: var(--ink); font-weight: 700; }
  .awards dd { font-size: var(--step-0); font-weight: 500; color: var(--muted); text-align: right; }
  .press { color: var(--muted); max-width: 60ch; }
  @media (min-width: 860px) { .recog { grid-template-columns: 1.2fr 1fr; gap: 4rem; } }

  .next { margin-top: clamp(3rem, 8vw, 6rem); }
  .next a {
    display: block; text-decoration: none; padding-block: 1.25rem;
    border-top: 1px solid var(--ink);
  }
  .next-title { display: block; margin-top: 0.5rem; font-size: var(--step-1); font-weight: 700; letter-spacing: -0.02em; line-height: 1; }
  .next a:hover .next-title { color: var(--accent); }
</style>
